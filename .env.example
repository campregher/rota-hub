# Global / Backend
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
CORS_ORIGIN=*

# Supabase
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_POD_BUCKET=rotahub-pod

# Auth JWT (Nest)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MARKETPLACE_TOKEN_ENCRYPTION_KEY=change_me_marketplace_token_key

# Business flags
POD_REQUIRED=true

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Integrations placeholders
ML_CLIENT_ID=ml_client_id_placeholder
ML_CLIENT_SECRET=ml_client_secret_placeholder
ML_REDIRECT_URI=http://localhost:3000/integrations/mercadolivre/callback
SHOPEE_CLIENT_ID=shopee_client_id_placeholder
SHOPEE_CLIENT_SECRET=shopee_client_secret_placeholder
SHOPEE_REDIRECT_URI=http://localhost:3000/integrations/shopee/callback
